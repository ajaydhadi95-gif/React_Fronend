pipeline {
    agent any

    environment {
        IMAGE_NAME = 'ajaydhadi95/booking_frontend'
        IMAGE_TAG  = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/ajaydhadi95-gif/React_frontend.git'
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME}:latest

                        docker logout
                    '''
                }
            }
        }

        stage('K8s Deployment') {
            steps {
                sh '''
                    kubectl apply -f deployment.yaml

                    kubectl set image deployment/booking-frontend \
                        booking-frontend=${IMAGE_NAME}:${IMAGE_TAG}

                    kubectl rollout status deployment/booking-frontend
                '''
            }
        }
    }

    post {
        success {
            echo "Deployment Successful!"
            cleanWs()
            sh 'docker image prune -f'
        }

        failure {
            echo "Deployment Failed!"
            cleanWs()
        }
    }
}