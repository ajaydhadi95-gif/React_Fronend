pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/ajaydhadi95-gif/Booking_app_frontend.git'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t booking_frontend:latest .'
            }
        }

    }
}